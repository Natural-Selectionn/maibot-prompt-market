# Copy to .env.local for the default Node + SQLite runtime.
# Local preview only. Credentials are intentionally empty.
AUTH_URL=http://127.0.0.1:3000
MAIBOT_PUBLIC_ORIGIN=http://127.0.0.1:3000
MAIBOT_DATABASE_PATH=./data/maibot.sqlite
HOSTNAME=127.0.0.1
PORT=3000
MAIBOT_ALLOW_TEST_LOGIN=0

# Create your own applications. Callback: AUTH_URL/api/auth/callback/<provider>
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional email registration, password reset and binding.
# EMAIL_AUTH_SECRET needs at least 32 characters; generate a random value.
RESEND_API_KEY=
RESEND_FROM=
EMAIL_AUTH_SECRET=

# Optional AI moderation: 64 hexadecimal characters, generated independently.
# Configure provider endpoints/models/keys in the administrator panel.
MODERATION_ENCRYPTION_KEY=
MODERATION_LOCAL_ENDPOINT=
